# Fish.IO room server — copy to .env and adjust (all optional).
# Values in .env are used unless the same variable is already set in the shell.
ROOM_HOST=0.0.0.0
ROOM_PORT=8787
ROOM_MAX_PLAYERS=16
ROOM_TICK_RATE=60
ROOM_SNAPSHOT_RATE=20
# 0 = random seed each boot; set a number for deterministic arenas.
ROOM_SEED=0
ROOM_RECONNECT_GRACE_MS=20000
ROOM_MAX_MSGS_PER_SEC=120
ROOM_NAME=reef-1
