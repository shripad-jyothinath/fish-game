# Fish.IO room server — production template (copy to .env and edit).
# Binds to loopback; Caddy terminates TLS/WSS and proxies here.
ROOM_HOST=127.0.0.1
ROOM_PORT=18787
ROOM_NAME=reef-1
ROOM_MAX_PLAYERS=32
ROOM_TICK_RATE=60
ROOM_SNAPSHOT_RATE=20
ROOM_RECONNECT_GRACE_MS=20000
ROOM_MAX_MSGS_PER_SEC=120
# 0 = fresh arena seed each boot.
ROOM_SEED=0
