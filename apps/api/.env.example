# --- Fish.IO API (dev defaults) ---
NODE_ENV=development
HOST=127.0.0.1
PORT=8080

# Match docker-compose.yml
DATABASE_URL=postgres://fishio:fishio@127.0.0.1:5432/fishio
REDIS_URL=redis://127.0.0.1:6379

# Local-dev account database (SQLite). Defaults to apps/api/data/fishio.db.
# FISHIO_DB_PATH=

# HMAC secret used by room servers to sign match results (dev only!)
INTERNAL_HMAC_SECRET=dev-secret-change-me

# --- Hedera (testnet) — fill in when Phase 1 starts ---
# HEDERA_NETWORK=testnet
# HEDERA_OPERATOR_ID=0.0.xxxxx
# HEDERA_OPERATOR_KEY=303...
#
# Optional overrides (auto-created & persisted in the DB on first use):
# HEDERA_TOPIC_ID=0.0.xxxxx
# HEDERA_GOLD_TOKEN_ID=0.0.xxxxx
# HEDERA_NFT_COLLECTION_ID=0.0.xxxxx
#
# $GOLD token defaults
# HEDERA_GOLD_NAME=Fish.IO Gold
# HEDERA_GOLD_SYMBOL=GOLD
# HEDERA_GOLD_DECIMALS=2
# HEDERA_GOLD_INITIAL_SUPPLY=1000000
#
# Reward limits
# HEDERA_REWARD_DAILY_CAP=500
# HEDERA_REWARD_MATCH_CAP=100
# HEDERA_MATCH_COOLDOWN_MS=10000
#
# Limited-edition mint caps (JSON). Defaults ship with the 1-of-1 Golden Leviathan.
# HEDERA_EDITION_LIMITS={"golden_leviathan":1}
#
# Public URL used in NFT metadata (must be reachable by explorers once deployed)
# PUBLIC_BASE_URL=http://127.0.0.1:8080
#
# Endpoint overrides (defaults derive from HEDERA_NETWORK)
# HEDERA_MIRROR_URL=https://testnet.mirrornode.hedera.com/api/v1
# HEDERA_HASHSCAN_URL=https://hashscan.io/testnet
