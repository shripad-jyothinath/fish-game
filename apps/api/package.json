{
  "name": "@fishio/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Fish.IO backend: website host, auth, matchmaking, results intake, economy.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "test": "node --import tsx --test test/hedera.test.ts test/auth.test.ts",
    "hedera:setup": "tsx bin/hedera-setup.ts",
    "hedera:wallet": "tsx bin/create-wallet.ts",
    "hedera:claim": "tsx bin/claim-airdrops.ts",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@fastify/cookie": "~11.0.2",
    "@fastify/cors": "^10.0.1",
    "@fastify/static": "^8.1.0",
    "@fishio/game-core": "*",
    "@hiero-ledger/sdk": "^2.89.1",
    "better-sqlite3": "^11.10.0",
    "fastify": "^5.2.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "tsx": "^4.19.2"
  }
}
