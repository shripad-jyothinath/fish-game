# Fish.IO API — production template (copy to .env and edit).
# local dev keeps using `npm run dev` defaults; this file is only for the VPS.
NODE_ENV=production
# Bind to loopback only; Caddy terminates TLS and proxies to this port.
HOST=127.0.0.1
PORT=18080

# Browser origins allowed to call the API with cookies across sites
# (your Vercel URL and/or custom domain). Comma-separated, no trailing slash.
WEB_ORIGIN=https://your-game.vercel.app,https://game.example.com

# Secret room servers will use to sign match results (M4). Use a long random string.
INTERNAL_HMAC_SECRET=replace-with-a-long-random-value

# 💰 → $GOLD conversion (account panel). 100 in-game gold = 1 $GOLD by default;
# at most 20,000 gold convertible per UTC day. Set daily to 0 to disable.
GOLD_CONVERT_RATE=100
GOLD_CONVERT_DAILY_GOLD=20000

# SQLite file (defaults to <repo>/apps/api/data/fishio.db)
# FISHIO_DB_PATH=/opt/fishio/app/apps/api/data/fishio.db

# ---- Hedera testnet (optional; copy the real values from your local apps/api/.env) ----
# HEDERA_NETWORK=testnet
# HEDERA_OPERATOR_ID=0.0.xxxxx
# HEDERA_OPERATOR_KEY=...
# HEDERA_TOPIC_ID=0.0.xxxxx
# HEDERA_GOLD_TOKEN_ID=0.0.xxxxx
# HEDERA_NFT_COLLECTION_ID=0.0.xxxxx
# WALLET_ENCRYPTION_KEY=...
# HEDERA_AUTO_WALLETS=true
