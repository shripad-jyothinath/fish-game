{
  "name": "fish-io",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "web:serve": "python -m http.server 8137 --bind 127.0.0.1 -d apps/web",
    "game-core:test": "node --test packages/game-core/test/sim.test.js",
    "game-core:sim": "node packages/game-core/bin/sim.js",
    "api:dev": "node apps/api/src/index.ts",
    "api:typecheck": "tsc --noEmit -p apps/api",
    "typecheck": "tsc --noEmit -p apps/api"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0"
  }
}
